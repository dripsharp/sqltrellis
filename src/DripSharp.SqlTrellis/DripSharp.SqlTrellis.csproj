<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CS0108;CS0162;CS0168;CS0219</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>DripSharp.SqlTrellis</AssemblyName>
    <RootNamespace>DripSharp.SqlTrellis</RootNamespace>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PackageId>DripSharp.SqlTrellis</PackageId>
    <Version>5.3.0-dripsharp.0</Version>
    <Title>SqlTrellis — JSqlParser for .NET</Title>
    <Description>JSqlParser for .NET, mechanically translated by DripSharp as an independent project not affiliated with or endorsed by the JSqlParser project.</Description>
    <Authors>JSqlParser contributors,Vibeformer translation</Authors>
    <PackageTags>sql parser jsqlparser dotnet sqltrellis dripsharp</PackageTags>
    <PackageProjectUrl>https://github.com/JSQLParser/JSqlParser</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JSQLParser/JSqlParser.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryCommit>8a9479a05c75fcb73d0ed167a822b9b18ab7abaa</RepositoryCommit>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DripSharp.SqlTrellis.Tests</_Parameter1>
    </AssemblyAttribute>
    <EmbeddedResource Include="resources/rr/xhtml2rst.xsl" LogicalName="rr/xhtml2rst.xsl" />
    <None Include="src/Legal/LICENSE.txt" Pack="true" PackagePath="LICENSE.txt" />
  </ItemGroup>
</Project>

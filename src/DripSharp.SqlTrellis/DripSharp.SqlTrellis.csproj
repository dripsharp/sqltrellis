<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CS0108;CS0162;CS0168;CS0219</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>DripSharp.SqlTrellis</AssemblyName>
    <RootNamespace>DripSharp.SqlTrellis</RootNamespace>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <PackageId>DripSharp.SqlTrellis</PackageId>
    <Version>5.3.0-alpha.1</Version>
    <Title>SqlTrellis — JSqlParser for .NET</Title>
    <Description>JSqlParser for .NET, mechanically translated by DripSharp as an independent project not affiliated with or endorsed by the JSqlParser project.</Description>
    <Authors>Isak Sky</Authors>
    <Copyright>Portions Copyright JSqlParser contributors; see LICENSE.txt and NOTICE.txt.</Copyright>
    <PackageTags>sql parser jsqlparser dotnet sqltrellis dripsharp</PackageTags>
    <PackageProjectUrl>https://github.com/dripsharp/sqltrellis</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dripsharp/sqltrellis.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.0" />
    <SourceRoot Include="$(MSBuildProjectDirectory)/" RepositoryUrl="https://github.com/dripsharp/sqltrellis.git" SourceControl="git" RevisionId="$(RepositoryCommit)" SourceLinkUrl="https://raw.githubusercontent.com/dripsharp/sqltrellis/$(RepositoryCommit)/src/DripSharp.SqlTrellis/*" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DripSharp.SqlTrellis.Tests</_Parameter1>
    </AssemblyAttribute>
    <EmbeddedResource Include="resources/rr/xhtml2rst.xsl" LogicalName="rr/xhtml2rst.xsl" />
    <None Include="src/Legal/LICENSE.txt" Pack="true" PackagePath="LICENSE.txt" />
    <None Include="src/Legal/NOTICE.txt" Pack="true" PackagePath="NOTICE.txt" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
